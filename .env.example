# Server Configuration
API_PORT=3000
API_HOST=0.0.0.0

# iOS Simulator
XCODE_PATH=/Applications/Xcode.app

# Android SDK
ANDROID_SDK_ROOT=/Users/$USER/Library/Android/sdk

# Database
DATABASE_URL=file:./data/simulator.db

# Session Concurrency
# Maximum concurrent active sessions (0 = unlimited)
MAX_CONCURRENT_SESSIONS=6
# Maximum concurrent active sessions per platform (0 = unlimited, global cap still applies)
MAX_SESSIONS_PER_PLATFORM=0
# How long (ms) terminated/error sessions stay in memory before eviction (DB keeps them)
SESSION_MEMORY_EVICTION_MS=900000
# Warm pool size — number of booted-but-idle iOS Simulators to keep per (deviceType, runtime)
# 0 = pool disabled (always teardown on session end)
IOS_WARM_POOL_SIZE=0

# =============================================================================
# Distributed Mode (master / worker)
# =============================================================================
# Leave NODE_MODE unset or set to "standalone" for single-machine deployment.
# Set to "master" for the orchestration node (no macOS/Xcode required).
# Set to "worker" for macOS simulation nodes that register with a master.

# Deployment mode: standalone | master | worker (default: standalone)
NODE_MODE=standalone

# Base URL of the master node — required when NODE_MODE=worker
# e.g. http://10.0.1.1:3000
MASTER_URL=

# Shared secret for master <-> worker authentication
# Must be set identically on master and all worker nodes
WORKER_SECRET=

# Publicly reachable base URL of this worker node — required when NODE_MODE=worker
# e.g. http://192.168.1.10:3000
WORKER_PUBLIC_URL=

# Maximum concurrent iOS Simulator sessions this worker accepts (worker only)
WORKER_MAX_IOS_SESSIONS=3

# Maximum concurrent Android Emulator sessions this worker accepts (worker only)
WORKER_MAX_ANDROID_SESSIONS=2

# Heartbeat interval in milliseconds (worker only)
WORKER_HEARTBEAT_INTERVAL_MS=30000

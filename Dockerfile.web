# Stage 1: Build Angular app
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy workspace files
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/web/package.json packages/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source
COPY packages/shared/ packages/shared/
COPY packages/web/ packages/web/

# Build shared first, then web
RUN pnpm --filter @web-mobile-simulator/shared build
RUN pnpm --filter @web-mobile-simulator/web build

# Stage 2: Serve with Caddy
FROM caddy:2-alpine

COPY Caddyfile /etc/caddy/Caddyfile
# Angular output path confirmed from packages/web/dist/web/browser/ (angular.json project "web",
# builder @angular/build:application defaults to dist/<projectName>/browser)
COPY --from=builder /app/packages/web/dist/web/browser /srv/web

EXPOSE 80

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile"]

{
  "name": "web-mobile-simulator",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "start": "./scripts/start.sh",
    "stop": "./scripts/stop.sh",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:detach": "docker compose -f docker-compose.dev.yml up --build -d",
    "docker:stop": "docker compose -f docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:clean": "docker compose -f docker-compose.dev.yml down -v --rmi local"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.58.1"
  }
}
